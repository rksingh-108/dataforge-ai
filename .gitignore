# ---------------------------------------------------------------------------
# DataForge AI — repository-wide ignore rules
# ---------------------------------------------------------------------------

# --- Secrets: never commit these -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log

# --- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Data / artifacts ------------------------------------------------------
*.sqlite3
*.db
media/
staticfiles/
uploads/
/tmp/
.cache/

# --- Local agent/tool state (not part of the project) ----------------------
.freebuff/
