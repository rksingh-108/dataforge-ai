# =============================================================================
# DataForge AI — environment configuration template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit a populated .env.
#   cp .env.example .env
# Generate a secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate a Fernet key for credential encryption:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# --- Core / Django ---------------------------------------------------------
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=UTC

# --- Primary database (PostgreSQL + pgvector) ------------------------------
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=replace-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dataforge:replace-me-db-password@db:5432/dataforge

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT / auth ------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Credential encryption (data-source passwords at rest) -----------------
# Fernet key. Losing this key makes stored data-source credentials unreadable.
DATAFORGE_FERNET_KEY=replace-me-with-a-urlsafe-base64-32-byte-key

# --- Internal service auth (API <-> AI service) ----------------------------
# Shared bearer token required on every AI-service call. Not a user credential.
INTERNAL_SERVICE_TOKEN=replace-me-with-a-long-random-internal-token
AI_SERVICE_URL=http://ai-service:8001

# --- LLM provider abstraction ----------------------------------------------
# Provider is selected entirely by configuration. Supported values:
#   openai | anthropic | azure_openai | ollama | openai_compatible
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-me-or-leave-blank-for-local-ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# --- Embeddings ------------------------------------------------------------
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me

# --- RAG -------------------------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

# --- SQL execution safety --------------------------------------------------
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=500
SQL_MAX_JOINS=6

# --- Frontend (apps/web) ---------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=DataForge AI

# --- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
